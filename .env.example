# Supabase Configuration (Optional - for Cloud Persistence & Vercel)
# If left empty, Cheer Stand will use local data/db.json
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# Server Port
PORT=3100

# Admin Password (Default: 1234)
CHEER_ADMIN_PASSWORD=1234

# Secret used to sign player/admin session tokens (set a long random value in production)
SESSION_SECRET=change-me-to-a-long-random-string
